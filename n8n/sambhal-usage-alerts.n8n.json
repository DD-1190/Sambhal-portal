{
  "name": "Sambhal - Usage and hours alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "65b8cf29-b00e-49e0-9bb0-26af04f25c11",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM v_alerts_due;",
        "options": {}
      },
      "id": "2bba4414-713b-4d00-8982-d0a1bcb88fd2",
      "name": "Alerts due",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Sambhal Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One email to you per run, listing every new alert.\nconst rows = $input.all().map(i => i.json);\nconst label = { usage_80: 'Usage at 80% of cap', usage_100: 'Usage cap reached', hours_80: 'Expert hours at 80%' };\nconst html = '<p>New alerts from the Sambhal portal:</p><ul>' +\n  rows.map(r => '<li><b>' + r.name + '</b>: ' + label[r.kind] + '. ' + r.detail + '</li>').join('') + '</ul>';\nreturn [{ json: {\n  subject: 'Sambhal: ' + rows.length + ' account alert' + (rows.length > 1 ? 's' : ''),\n  html,\n  keys: rows.map(r => ({ account_id: r.account_id, kind: r.kind }))\n} }];\n"
      },
      "id": "f7a5bade-243f-4a92-9c8e-4ecf874461b9",
      "name": "Owner email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "CHANGE_ME_YOUR_EMAIL",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {}
      },
      "id": "18c6c826-505a-4a77-8a4f-4f9dacdbfb2e",
      "name": "Email me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alerts_sent (account_id, kind, month) SELECT (x->>'account_id')::uuid, x->>'kind', date_trunc('month', now())::date FROM jsonb_array_elements($1::jsonb) x ON CONFLICT DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($('Owner email').first().json.keys)] }}"
        }
      },
      "id": "c59481aa-12a3-456a-a869-6faf7934325c",
      "name": "Mark alerts sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Sambhal Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp notice to the dealer when usage reaches 80% or 100% of the monthly cap.\n// Needs the approved template 'usage_notice' (one variable). Skips dealers with no number.\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (r.kind.indexOf('usage_') !== 0 || !r.dealer_phone || !r.phone_number_id) continue;\n  const text = r.kind === 'usage_80' ? '80%' : '100% (AI ke free-text jawab ruk gaye hain)';\n  out.push({ json: { phone_number_id: r.phone_number_id, token: r.access_token, payload: {\n    messaging_product: 'whatsapp', to: r.dealer_phone, type: 'template',\n    template: { name: 'usage_notice', language: { code: 'en' },\n      components: [{ type: 'body', parameters: [{ type: 'text', text }] }] } } } });\n}\nreturn out;\n"
      },
      "id": "12d246a7-678a-4116-958f-970286b61e4b",
      "name": "Dealer notices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "6c12aaca-52e3-4fba-bb8f-2dfa4f19c02e",
      "name": "Send dealer notice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Alerts due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alerts due": {
      "main": [
        [
          {
            "node": "Owner email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Dealer notices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Owner email": {
      "main": [
        [
          {
            "node": "Email me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email me": {
      "main": [
        [
          {
            "node": "Mark alerts sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dealer notices": {
      "main": [
        [
          {
            "node": "Send dealer notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}